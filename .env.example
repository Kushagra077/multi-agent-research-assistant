# Planner LLM (Gemini)
GEMINI_API_KEY=
# Researcher and writer LLM (Groq)
GROQ_API_KEY=

# Researcher web search (Tavily)
TAVILY_API_KEY=

# Jev decision model (TypeSafe)
TYPESAFE_API_KEY=

# Optional: LangSmith tracing. Off by default. If you switch it on, every prompt (research
# questions, page text, drafts) is sent to LangSmith; Jev calls are traced without the page
# text. Leave it off unless you are happy with that.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-assistant

# Optional: where the API keeps its checkpoints (default checkpoints.db)
# RESEARCH_DB=checkpoints.db
