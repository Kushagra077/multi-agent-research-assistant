# Researcher, writer and (by default) planner LLM (Groq)
GROQ_API_KEY=
# Planner provider: groq (default) or gemini. Gemini's free tier often answers 504.
# PLANNER_PROVIDER=groq
# Demo mode: PLANNER_PROVIDER=fixed uses a fixed 3-subtask guitar plan (or your own, in
# DEMO_PLAN, subtasks separated by "|"). Searching, Jev, the writer and the review stay
# real; the review page shows a banner saying the plan is fixed.
# DEMO_PLAN=
GEMINI_API_KEY=   # only needed when PLANNER_PROVIDER=gemini

# Researcher web search (Tavily)
TAVILY_API_KEY=

# Jev decision model (TypeSafe)
TYPESAFE_API_KEY=

# Optional: LangSmith tracing. Off by default. If you switch it on, every prompt (research
# questions, page text, drafts) is sent to LangSmith; Jev calls are traced without the page
# text. Leave it off unless you are happy with that.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-assistant

# Optional: where the API keeps its checkpoints (default checkpoints.db)
# RESEARCH_DB=checkpoints.db
